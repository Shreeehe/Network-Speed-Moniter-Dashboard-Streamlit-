# Streamlit Community Cloud Secrets Example
# Copy this to .streamlit/secrets.toml for local testing, or paste into
# Streamlit Community Cloud: App Settings -> Secrets for cloud deployment.

# Supabase Project URL & Anon/Publishable Key (Read-only via RLS)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-publishable-key"

# Dashboard password gate (protects public Streamlit Cloud deployment)
APP_PASSWORD = "change_me_to_a_strong_password"
